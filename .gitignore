# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Testes e ferramentas
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Ambiente
.env
*.key
*.pem
credenciais*.json

# Imagens de satélite não são versionadas: são grandes, regeneráveis pelo script de
# aquisição, e a licença de cada uma está registrada em data/raw/FONTES.md. Os diretórios
# são criados pelo próprio download.
_interno/data/raw/*
_interno/data/interim/
_interno/data/processed/
!_interno/data/raw/FONTES.md
# Manifestos de aquisição são metadado de procedência, não dado: pequenos e
# necessários para reproduzir o download.
!_interno/data/raw/*_manifesto.json

# Modelos treinados (regeneráveis a partir do código)
*.joblib
*.pkl
modelos/*.pth

# Saídas descartáveis da aplicação. Os três arquivos entregues ficam em entrega/ e são
# versionados de propósito: é o que vai para o professor e para o site da UNIP.
saidas/
*.log

# Editores e SO
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*:Zone.Identifier

# Streamlit
.streamlit/secrets.toml

# Graphify — ferramenta auxiliar do agente, nunca versionada (AGENTS.md global §55)
/graphify-out/
/.handoff/
.graphify_analysis.json
.graphify_labels.json

# --------------------------------------------------------------------------------------
# Ferramental do agente de IA e documentação de processo. Fica no disco de quem
# desenvolve, não no GitHub: não é entregável e polui a leitura do repositório.
# --------------------------------------------------------------------------------------
/AGENTS.md
/CLAUDE.md
/.graphifyignore
/_interno/docs/agent-memory.md
/_interno/docs/PROJECT_SPEC.md
/_interno/docs/PROJECT_STATE.md
/_interno/docs/REQUIREMENTS.md
/_interno/docs/ARCHITECTURE.md
/_interno/docs/decisions/
/_interno/docs/trabalho-escrito/README.md

# Apêndice de código: é gerado por `sentinela apendice` a partir de src/. Versioná-lo
# duplicaria o código-fonte inteiro dentro de docs/ e sairia do ar a cada alteração.
/_interno/docs/trabalho-escrito/07-apendice.md

# Claude Kit: agents, hooks, configuração local e estado do kit ficam só na máquina de
# quem usa. Não vão para os outros integrantes.
/.claude/
/.claude-kit/
/_interno/docs/DECISIONS.md
/_interno/docs/HANDOFF.md
.claude-kit/backup/
.claude-kit/proposals/
.claude-kit/hermes-outbox/
